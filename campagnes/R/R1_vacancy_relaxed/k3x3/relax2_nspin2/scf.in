! R1b — scf 3x3x1 (relax2_nspin2), nspin=2
! monovacancy at center of 9x9 supercell

&CONTROL
  calculation = 'scf'
  prefix      = 'k3x3_relax2_nspin2'        ! prefix of output files
  outdir      = '/home/gregb26/links/scratch/qe_tmp/vacancy_relaxed/k3x3/relax2_nspin2'   ! directory of tempory files
  tprnfor     = .true.
  pseudo_dir  = '/home/gregb26/links/projects/rrg-cotemich-ac/gregb26/abinit_processing/pseudo' ! directory of pseudo potentials
/
&SYSTEM
  ibrav       = 0        ! specified by CELL_PARAMETERS
  nat         = 161       ! number of atoms (161 = 2 x 9 x 9 - 1 vacancy)
  ntyp        = 2        ! C (158 atomes) + C1 (3 voisins de la lacune, même pseudo)
  ecutwfc     = 100      ! PW energy cutoff in Ry (1 Ha = 2 Ry)
  occupations = 'smearing'
  smearing    = 'mv'     ! Marzari-Vanderbilt cold smearing
  degauss     = 0.01     ! value of gaussian smearing in Ry
  nbnd        = 352      ! 644 valence electrons -> 322 occupied; adjust as needed
  assume_isolated = '2D' ! helps for 2d systems
  nosym       = .true.
  noinv       = .true.
  nspin       = 2
  starting_magnetization(1) = 0.0   ! C
  starting_magnetization(2) = 0.5   ! C1 (atomes 64, 80, 81)
/
&ELECTRONS
  electron_maxstep =  400   ! number of iterations in SCF step
  conv_thr         =  1.d-10 ! convergence threshold for self-consistency
  mixing_beta      =  0.3
/

ATOMIC_SPECIES
  C  12.011 C.upf ! atom type and pseudo potential
  C1 12.011 C.upf ! voisins de la lacune (64, 80, 81), même pseudo

CELL_PARAMETERS bohr
