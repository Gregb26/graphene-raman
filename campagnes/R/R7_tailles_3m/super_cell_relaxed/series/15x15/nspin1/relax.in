! R7c — relax (cellule fixe) de la supercellule 15x15 avec lacune, nspin=1
! dérivé de super_cell/15x15/defective/scf.in (R7) ; géométrie initiale = champ de déplacements de la 12x12 relaxée (R2 nspin1) transplanté par inversion (lacune B -> A), R_cut = 14.5 A, 225 atomes déplacés ; voisins [225, 224, 196]

&CONTROL
  calculation = 'relax'     ! ions relaxés, cellule fixe
  prefix      = 'vac_15x15_relax_nspin1'
  outdir      = '/home/gregb26/links/scratch/qe_tmp/vacancy_relaxed/series/15x15/nspin1'
  forc_conv_thr = 1.0d-4
  etot_conv_thr = 1.0d-5
  nstep       = 200
  tprnfor     = .true.
  pseudo_dir  = '/home/gregb26/links/projects/rrg-cotemich-ac/gregb26/abinit_processing/pseudo' ! directory of pseudo potentials
/
&SYSTEM
  ibrav       = 0        ! specified by CELL_PARAMETERS
  nat         = 449       ! number of atoms (449 = 2 x 15 x 15 - 1 vacancy)
  ntyp        = 1        ! number of atom types
  ecutwfc     = 100      ! PW energy cutoff in Ry (1 Ha = 2 Ry)
  occupations = 'smearing'
  smearing    = 'mv'     ! Marzari-Vanderbilt cold smearing
  degauss     = 0.01     ! value of gaussian smearing in Ry
  nbnd        = 928      ! 1796 valence electrons -> 898 occupied; adjust as needed
  assume_isolated = '2D' ! helps for 2d systems
  nosym       = .true.
  noinv       = .true.
/
&ELECTRONS
  electron_maxstep =  400   ! number of iterations in SCF step
  conv_thr         =  1.d-10 ! convergence threshold for self-consistency
  mixing_beta      =  0.3
/

&IONS
  ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
  C 12.011 C.upf ! atom type and pseudo potential


CELL_PARAMETERS bohr
