#!/bin/bash
#SBATCH --account=rrg-cotemich-ac
#SBATCH --job-name=R7c_restart_24x24_nspin1
#SBATCH --mail-type=NONE          # Mail events (NONE,BEGIN,END,FAIL,ALL)
#SBATCH --nodes=3
#SBATCH --ntasks=192
#SBATCH --ntasks-per-node=64
#SBATCH --cpus-per-task=1
#SBATCH --mem=0               # memory; default unit is megabytes
#SBATCH --time=1-12:00:00          # time (DD-HH:MM) — reprise : ≈ 2–6 cycles de 2 h restants (projection 2026-09-27)
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

# Reprise automatique R7c de la 24x24 (Greg, 2026-09-27 : reprise sans GO, soumise d'avance) :
#   sbatch --dependency=afternotok:21852176 --kill-on-invalid-dep=yes submit.relax_restart_auto
# SLURM l'annule si 21852176 finit COMPLETED. afternotok part aussi sur FAILED/OUT_OF_MEMORY/CANCELLED : la garde
# ci-dessous ne relance que si la 24x24 a buté (TIMEOUT) ou perdu un nœud (NODE_FAIL), jamais si la BFGS a déjà
# convergé, et n'écrase jamais un relax_restart.out existant. Si sacct reste muet ou en retard, relax.out tranche.
PREV=21852176
st=""
for i in $(seq 1 20); do
  st=$(sacct -j $PREV -X -n -o State%14 2>/dev/null | head -1 | tr -d ' ')
  case "$st" in ""|PENDING|RUNNING|COMPLETING|REQUEUED*|SUSPENDED) sleep 30 ;; *) break ;; esac
done
echo "état de $PREV (sacct) : '${st:-inconnu}'"
if grep -q 'bfgs converged' relax.out; then echo "pas de reprise : BFGS déjà convergée dans relax.out"; exit 0; fi
if [ -e relax_restart.out ]; then echo "pas de reprise : relax_restart.out existe déjà (rien n'est écrasé)"; exit 0; fi
case "$st" in
  TIMEOUT|NODE_FAIL|PREEMPTED) echo "reprise : $PREV a buté ($st)" ;;
  COMPLETED|FAILED|OUT_OF_MEMORY|CANCELLED*|DEADLINE|BOOT_FAIL) echo "pas de reprise : état '$st'"; exit 0 ;;
  *) if [ -e CRASH ] || grep -q '%%%%%%' relax.out; then echo "pas de reprise : état '$st' et erreur QE dans relax.out"; exit 0; fi
     echo "état '$st' non concluant, relax.out interrompu sans erreur QE : reprise" ;;
esac

module restore qe

export OMP_NUM_THREADS=1

mkdir -p /home/gregb26/links/scratch/qe_tmp/vacancy_relaxed/series/24x24/nspin1
srun pw.x < relax_restart.in > relax_restart.out
