! R2 — relax (cellule fixe) de la supercellule 10x10 avec lacune, nspin=1
! dérivé de super_cell/10x10/defective/scf.in (ch. 4) ; perturbation initiale voisins 89-90, C1 = (89, 90, 108)

&CONTROL
  calculation = 'relax'     ! ions relaxés, cellule fixe
  prefix      = 'vac_10x10_relax_nspin1'
  outdir      = '/home/gregb26/links/scratch/qe_tmp/vacancy_relaxed/series/10x10/nspin1'
  forc_conv_thr = 1.0d-4
  etot_conv_thr = 1.0d-5
  nstep       = 200
  tprnfor     = .true.
  pseudo_dir  = '/home/gregb26/links/projects/rrg-cotemich-ac/gregb26/abinit_processing/pseudo'
/
&SYSTEM
  ibrav       = 0
  nat         = 199       ! number of atoms
  ntyp        = 1
  ecutwfc     = 100
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.01
  nbnd        = 428      ! 796 valence electrons -> 398 occupied bands; adjust as needed
  assume_isolated = '2D'
  nosym       = .true.
  noinv       = .true.
/
&ELECTRONS
  electron_maxstep = 400
  conv_thr         = 1.d-10
  mixing_beta      = 0.3
/

&IONS
  ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
  C 12.011 C.upf


