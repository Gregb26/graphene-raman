! R7c — relax (cellule fixe) de la supercellule 27x27 avec lacune, nspin=1
! dérivé de super_cell/27x27/defective/scf.in (R7) ; géométrie initiale = champ de déplacements de la 12x12 relaxée (R2 nspin1) transplanté par inversion (lacune B -> A), R_cut = 14.5 A, 225 atomes déplacés ; voisins [729, 728, 676]

&CONTROL
  calculation = 'relax'     ! ions relaxés, cellule fixe
  prefix      = 'vac_27x27_relax_nspin1'
  outdir      = '/home/gregb26/links/scratch/qe_tmp/vacancy_relaxed/series/27x27/nspin1'
  forc_conv_thr = 1.0d-4
  etot_conv_thr = 1.0d-5
  nstep       = 200
  tprnfor     = .true.
  pseudo_dir  = '/home/gregb26/links/projects/rrg-cotemich-ac/gregb26/abinit_processing/pseudo' ! directory of pseudo potentials
/
&SYSTEM
  ibrav       = 0        ! specified by CELL_PARAMETERS
  nat         = 1457       ! number of atoms (1457 = 2 x 27 x 27 - 1 vacancy)
  ntyp        = 1        ! number of atom types
  ecutwfc     = 100      ! PW energy cutoff in Ry (1 Ha = 2 Ry)
  occupations = 'smearing'
  smearing    = 'mv'     ! Marzari-Vanderbilt cold smearing
  degauss     = 0.01     ! value of gaussian smearing in Ry
  nbnd        = 3066      ! 5828 valence electrons -> 2914 occupied; adjust as needed
  assume_isolated = '2D' ! helps for 2d systems
  nosym       = .true.
  noinv       = .true.
/
&ELECTRONS
  electron_maxstep =  400   ! number of iterations in SCF step
  conv_thr         =  1.d-10 ! convergence threshold for self-consistency
  mixing_beta      =  0.3
/

&IONS
  ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
  C 12.011 C.upf ! atom type and pseudo potential


CELL_PARAMETERS bohr
  108.9582814647  -62.9070931341   0.0000000000
  108.9582814647   62.9070931341   0.0000000000
   0.0000000000             0.0000000000            30.0000000000

